{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt2serviceflow.local/schemas/runtime_manifest.schema.json",
  "title": "Prompt2ServiceFlow instance runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_manifest_version",
    "pipeline_id",
    "image",
    "workflow_parameters",
    "tasks",
    "scenarios"
  ],
  "properties": {
    "runtime_manifest_version": {
      "const": "0.1.0"
    },
    "pipeline_id": {
      "$ref": "#/$defs/snakeIdentifier"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "workflow_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "default"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "default": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent_id", "script", "arguments"],
        "properties": {
          "intent_id": {
            "$ref": "#/$defs/snakeIdentifier"
          },
          "script": {
            "type": "string",
            "pattern": "^scripts/[A-Za-z0-9_.-]+\\.py$"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/snakeIdentifier"
            }
          },
          "depends": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "local_condition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "json_path", "equals"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "json_path": {
                "type": "string",
                "minLength": 1
              },
              "equals": {}
            }
          },
          "output_parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "path"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "path": {
                  "type": "string",
                  "pattern": "^/workspace/"
                }
              }
            }
          },
          "retries": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters"],
        "properties": {
          "name": {
            "$ref": "#/$defs/snakeIdentifier"
          },
          "fixture_root": {
            "type": "string",
            "pattern": "^fixtures/(?:inputs|scenarios/[a-z][a-z0-9]*(?:_[a-z0-9]+)*)$"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        }
      }
    },
    "cron": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "timezone"],
      "properties": {
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "snakeIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
      "maxLength": 120
    }
  }
}
