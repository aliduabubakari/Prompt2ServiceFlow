{
  "comment": "Template for an OpenAI-compatible endpoint. Store the token only in P2SF_API_TOKEN.",
  "provider": {
    "name": "custom-openai-compatible",
    "base_url": "https://provider.example/v1",
    "models_url": "https://provider.example/v1/models"
  },
  "models": {
    "custom-model": {
      "model_name": "provider/model-name",
      "base_url": "https://provider.example/v1",
      "api_key_env": "P2SF_API_TOKEN",
      "max_tokens": 16384,
      "temperature": 0.2,
      "top_p": 1.0,
      "seed": 101,
      "request_timeout_s": 3600,
      "max_retries": 5,
      "context_window": 65536,
      "reasoning": false
    }
  }
}
