{
  "policy_id": "dicom-quality-v2",
  "description": "DICOM metadata quality assessment thresholds",
  "patient_id_pattern": "^PT-\\d{4}$",
  "required_fields": ["study_uid", "patient_id", "modality", "body_part", "image_count", "study_date"],
  "quality_grades": {
    "pass": {"max_issues": 0},
    "warning": {"max_issues": 2},
    "fail": {}
  }
}
