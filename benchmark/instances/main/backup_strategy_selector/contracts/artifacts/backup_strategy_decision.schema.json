{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["selected_strategy", "day_of_week", "matched_full_backup_day", "reason"],
  "properties": {
    "selected_strategy": {"enum": ["full", "incremental"]},
    "branch_label": {"type": ["string", "null"]},
    "day_of_week": {"type": "integer"},
    "matched_full_backup_day": {"type": "boolean"},
    "reason": {"type": "string"}
  }
}
