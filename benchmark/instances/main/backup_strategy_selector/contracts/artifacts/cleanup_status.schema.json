{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "targets_processed", "targets_deleted"],
  "properties": {
    "success": {"type": "boolean"},
    "targets_processed": {"type": "integer", "minimum": 0},
    "targets_deleted": {"type": "integer", "minimum": 0},
    "missing_targets": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
