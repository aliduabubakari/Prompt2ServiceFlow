{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["valid", "checks_run", "checks_failed", "artifact_readable"],
  "properties": {
    "valid": {"type": "boolean"},
    "checks_run": {"type": "integer", "minimum": 0},
    "checks_failed": {"type": "integer", "minimum": 0},
    "artifact_readable": {"type": "boolean"},
    "checksum_matched": {"type": ["boolean", "null"]},
    "completeness_passed": {"type": ["boolean", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
