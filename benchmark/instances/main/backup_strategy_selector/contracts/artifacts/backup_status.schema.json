{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "backup_mode", "backup_attempted", "output_uri"],
  "properties": {
    "success": {"type": "boolean"},
    "backup_mode": {"type": "string"},
    "backup_attempted": {"type": "boolean"},
    "output_uri": {"type": "string"},
    "bytes_written": {"type": ["integer", "null"], "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
