{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "route", "manual_review_requested", "transactions_marked_for_review"],
  "properties": {
    "success": {"type": "boolean"},
    "route": {"type": "string"},
    "manual_review_requested": {"type": "boolean"},
    "transactions_marked_for_review": {"type": "integer", "minimum": 0},
    "bounded_transaction_refs": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
