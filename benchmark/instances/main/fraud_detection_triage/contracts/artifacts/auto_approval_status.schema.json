{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "route", "auto_approval_recorded", "transactions_auto_approved"],
  "properties": {
    "success": {"type": "boolean"},
    "route": {"type": "string"},
    "auto_approval_recorded": {"type": "boolean"},
    "transactions_auto_approved": {"type": "integer", "minimum": 0},
    "bounded_transaction_refs": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
