{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["score", "score_range", "transactions_scored", "aggregate_score_method", "risk_model_profile"],
  "properties": {
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "score_range": {"const": "0_to_1"},
    "transactions_scored": {"type": "integer", "minimum": 0},
    "aggregate_score_method": {"type": "string"},
    "risk_model_profile": {"type": "string"}
  }
}
