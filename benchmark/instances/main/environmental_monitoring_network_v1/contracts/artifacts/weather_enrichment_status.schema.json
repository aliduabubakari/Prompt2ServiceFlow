{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "rows_processed", "rows_enriched", "variables_requested", "output_uri"],
  "properties": {
    "success": {"type": "boolean"},
    "rows_processed": {"type": "integer", "minimum": 0},
    "rows_enriched": {"type": "integer", "minimum": 0},
    "variables_requested": {"type": "array", "items": {"type": "string"}},
    "output_uri": {"type": "string"},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
