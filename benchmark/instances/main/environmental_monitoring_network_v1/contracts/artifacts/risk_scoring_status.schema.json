{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "rows_processed", "rows_scored", "output_column", "output_uri"],
  "properties": {
    "success": {"type": "boolean"},
    "rows_processed": {"type": "integer", "minimum": 0},
    "rows_scored": {"type": "integer", "minimum": 0},
    "output_column": {"type": "string"},
    "profile_id": {"type": ["string", "null"]},
    "output_uri": {"type": "string"},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
