{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "max_age_days",
    "cutoff_date",
    "delete_enabled"
  ],
  "properties": {
    "max_age_days": {
      "type": "integer",
      "minimum": 1
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "delete_enabled": {
      "type": "boolean"
    }
  }
}
