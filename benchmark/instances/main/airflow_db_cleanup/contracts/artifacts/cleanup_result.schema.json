{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table",
    "deleted_rows",
    "cutoff_date"
  ],
  "properties": {
    "table": {
      "type": "string",
      "minLength": 1
    },
    "deleted_rows": {
      "type": "integer",
      "minimum": 0
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    }
  }
}
