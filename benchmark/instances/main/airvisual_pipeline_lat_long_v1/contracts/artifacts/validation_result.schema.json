{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["valid", "checked_schema", "errors", "record_count"],
  "properties": {
    "valid": {"type": "boolean"},
    "checked_schema": {"type": "string"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "record_count": {"type": "integer", "minimum": 0}
  }
}
