{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["city", "state", "country", "coordinates", "pollution", "weather"],
  "properties": {
    "city": {"type": "string"},
    "state": {"type": "string"},
    "country": {"type": "string"},
    "coordinates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"}
    },
    "pollution": {"type": "object"},
    "weather": {"type": "object"}
  }
}
