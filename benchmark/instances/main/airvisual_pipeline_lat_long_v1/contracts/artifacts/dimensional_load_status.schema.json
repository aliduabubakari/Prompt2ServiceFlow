{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["success", "tables", "rows_inserted", "rows_upserted", "rows_skipped"],
  "properties": {
    "success": {"type": "boolean"},
    "tables": {"type": "array", "items": {"type": "string"}},
    "rows_inserted": {"type": "integer", "minimum": 0},
    "rows_upserted": {"type": "integer", "minimum": 0},
    "rows_skipped": {"type": "integer", "minimum": 0}
  }
}
